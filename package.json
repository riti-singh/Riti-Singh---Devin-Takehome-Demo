{
  "name": "riti-singh-devin-takehome-demo",
  "version": "1.0.0",
  "description": "Devin takehome demo",
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install --with-deps chromium && npm run seed",
    "seed": "tsx src/db/seed.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riti-singh/Riti-Singh---Devin-Takehome-Demo.git"
  },
